{
  "main": "dist/index.js",
  "name": "importmap-manager",
  "type": "module",
  "version": "2.0.0",
  "description": "A modern UI for managing importmap-overrides with an enhanced user experience.",
  "author": "Daniel David Díaz González <ddavid930826@gmail.com>",
